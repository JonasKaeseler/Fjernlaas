@page "/lokationer"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Politikker.Administration)]
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthState

<PageTitle>Lokationer – Fjernlås</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title">Lokationer</h1>
        <p class="muted">Steder med døre og andre ressourcer, fx en butik. Åbn en lokation for at se dens ressourcer.</p>
    </div>
    <button type="button" class="btn btn-primary btn-inline btn-add" aria-label="Tilføj lokation" @onclick="VisOpret"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg><span class="lbl">Tilføj lokation</span></button>
</div>

@if (_besked is not null)
{
    <div class="notice" role="status">@_besked</div>
}

@if (_viserForm)
{
    <div class="card card-flat">
        <div class="form-grid">
            @if (_formId is null && _aktoer?.ErPlatformAdmin == true)
            {
                <div class="field field-wide">
                    <label for="lokorg">Organisation</label>
                    <select id="lokorg" class="input" @bind="_formOrg">
                        <option value="">Vælg organisation</option>
                        @foreach (var org in _organisationer)
                        {
                            <option value="@org.Id">@org.Navn</option>
                        }
                    </select>
                </div>
            }
            <div class="field">
                <label for="loknavn">Navn</label>
                <input id="loknavn" class="input" maxlength="@LokationService.MaxNavnLaengde" @bind="_formNavn" @bind:event="oninput"
                       placeholder="fx Roshage Selvbetjening" />
            </div>
            <div class="field">
                <label for="loktid">Tidszone</label>
                <select id="loktid" class="input" @bind="_formTidszone">
                    @foreach (var tz in LokationService.Tidszoner)
                    {
                        <option value="@tz">@tz</option>
                    }
                </select>
            </div>
            <div class="field field-wide">
                <label for="lokadresse">Adresse (valgfri)</label>
                <input id="lokadresse" class="input" maxlength="@LokationService.MaxAdresseLaengde" @bind="_formAdresse" @bind:event="oninput" />
            </div>
        </div>

        @if (_formFejl is not null)
        {
            <div class="alert" role="alert">@_formFejl</div>
        }

        <div class="actions">
            <button type="button" class="btn btn-primary btn-inline" @onclick="GemAsync" disabled="@_arbejder">@(_formId is null ? "Opret lokation" : "Gem ændringer")</button>
            <button type="button" class="btn btn-secondary btn-inline" @onclick="AnnullerForm">Annuller</button>
        </div>
    </div>
}

@if (_lokationer is null)
{
    <p class="muted">Henter…</p>
}
else if (_lokationer.Count == 0)
{
    <div class="card card-flat empty">
        <strong>Ingen lokationer endnu</strong>
        <p class="muted">Tryk på "Tilføj lokation" for at oprette den første.</p>
    </div>
}
else
{
    <section class="card card-flat filterbar" aria-label="Filtre">
        <div class="filter-row">
            <div class="field field-grow">
                <label for="lok-soeg">Søg</label>
                <input id="lok-soeg" type="search" class="input" placeholder="Navn eller adresse" @bind="_soeg" @bind:event="oninput" />
            </div>
            @if (_aktoer?.ErPlatformAdmin == true)
            {
                <div class="field">
                    <label for="lok-org">Organisation</label>
                    <select id="lok-org" class="input" @bind="_orgFilter">
                        <option value="alle">Alle</option>
                        @foreach (var org in _organisationer)
                        {
                            <option value="@org.Id">@org.Navn</option>
                        }
                    </select>
                </div>
            }
        </div>
        <div class="chips" role="group" aria-label="Status">
            @foreach (var (v, l) in new[] { ("alle", "Alle"), ("aktiv", "Aktiv"), ("deaktiveret", "Deaktiveret") })
            {
                <button type="button" class="chip @(_statusFilter == v ? "chip-on" : "")" aria-pressed="@(_statusFilter == v ? "true" : "false")" @onclick="() => _statusFilter = v">@l</button>
            }
        </div>
        <div class="filter-foot">
            <span class="muted" aria-live="polite">@Antaltekst()</span>
            <div class="segmented" role="group" aria-label="Visning">
                <button type="button" class="seg @(_visKort ? "seg-on" : "")" aria-pressed="@(_visKort ? "true" : "false")" @onclick="() => _visKort = true">Kort</button>
                <button type="button" class="seg @(!_visKort ? "seg-on" : "")" aria-pressed="@(_visKort ? "false" : "true")" @onclick="() => _visKort = false">Liste</button>
            </div>
        </div>
    </section>

    var synlige = Synlige();
    if (synlige.Count == 0)
    {
        <div class="card card-flat empty">
            <strong>Ingen lokationer matcher filtrene</strong>
            <p class="muted">Prøv et andet søgeord, eller nulstil filtrene.</p>
            <button type="button" class="btn btn-secondary btn-inline" @onclick="NulstilFiltre">Nulstil filtre</button>
        </div>
    }
    else if (_visKort)
    {
        <div class="loc-grid">
            @foreach (var l in synlige)
            {
                <article class="loc-card" @key="l.Id">
                    <div class="loc-head">
                        <div class="loc-icon" aria-hidden="true">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
                        </div>
                        <span class="badge @(l.Status == LokationStatus.Aktiv ? "badge-ok" : "badge-off")">@(l.Status == LokationStatus.Aktiv ? "Aktiv" : "Deaktiveret")</span>
                    </div>
                    <div class="loc-body">
                        <h2 class="loc-name"><a href="lokationer/@l.Id">@l.Navn</a></h2>
                        <svg class="loc-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                        <span class="muted">@(l.Adresse ?? "Ingen adresse")</span>
                        <dl class="loc-facts">
                            <div><dt>Ressourcer</dt><dd class="mono">@l.AntalRessourcer</dd></div>
                            <div><dt>Tidszone</dt><dd class="mono">@l.Tidszone</dd></div>
                            @if (_aktoer?.ErPlatformAdmin == true)
                            {
                                <div class="loc-fact-wide"><dt>Organisation</dt><dd>@l.OrganisationNavn</dd></div>
                            }
                        </dl>
                        <div class="loc-actions">
                            <a class="btn btn-secondary btn-small btn-link" href="lokationer/@l.Id">Åbn</a>
                            <button type="button" class="btn btn-secondary btn-small" @onclick="() => VisRediger(l)">Rediger</button>
                            <button type="button" class="btn btn-secondary btn-small" disabled="@_arbejder" @onclick="() => SkiftStatusAsync(l)">
                                @(l.Status == LokationStatus.Aktiv ? "Deaktivér" : "Aktivér")
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="card card-flat table-card">
            <table class="table">
                <thead>
                    <tr>
                        <th>Navn</th>
                        @if (_aktoer?.ErPlatformAdmin == true)
                        {
                            <th>Organisation</th>
                        }
                        <th>Adresse</th>
                        <th>Ressourcer</th>
                        <th>Status</th>
                        <th class="actions-col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in synlige)
                    {
                        <tr @key="l.Id">
                            <td><a href="lokationer/@l.Id"><strong>@l.Navn</strong></a></td>
                            @if (_aktoer?.ErPlatformAdmin == true)
                            {
                                <td>@l.OrganisationNavn</td>
                            }
                            <td>@(l.Adresse ?? "–")</td>
                            <td>@l.AntalRessourcer</td>
                            <td>
                                <span class="badge @(l.Status == LokationStatus.Aktiv ? "badge-ok" : "badge-off")">
                                    @(l.Status == LokationStatus.Aktiv ? "Aktiv" : "Deaktiveret")
                                </span>
                            </td>
                            <td class="actions-col">
                                <button type="button" class="btn btn-secondary btn-small" @onclick="() => VisRediger(l)">Rediger</button>
                                <button type="button" class="btn btn-secondary btn-small" disabled="@_arbejder" @onclick="() => SkiftStatusAsync(l)">
                                    @(l.Status == LokationStatus.Aktiv ? "Deaktivér" : "Aktivér")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private Aktoer? _aktoer;
    private IReadOnlyList<OrganisationOversigt> _organisationer = [];
    private IReadOnlyList<LokationOversigt>? _lokationer;

    private string? _besked;
    private bool _arbejder;

    private string _soeg = string.Empty;
    private string _statusFilter = "alle";
    private string _orgFilter = "alle";
    private bool _visKort = true;

    private bool _viserForm;
    private Guid? _formId;
    private string _formOrg = string.Empty;
    private string _formNavn = string.Empty;
    private string _formAdresse = string.Empty;
    private string _formTidszone = LokationService.Tidszoner[0];
    private string? _formFejl;

    protected override async Task OnInitializedAsync()
    {
        var tilstand = await AuthState.GetAuthenticationStateAsync();
        _aktoer = Aktoer.Fra(tilstand.User);

        if (_aktoer.ErPlatformAdmin)
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            _organisationer = await scope.ServiceProvider.GetRequiredService<OrganisationService>().OversigtAsync();
        }

        await HentAsync();
    }

    private async Task HentAsync()
    {
        if (_aktoer is null) return;
        await using var scope = ScopeFactory.CreateAsyncScope();
        _lokationer = await scope.ServiceProvider.GetRequiredService<LokationService>().OversigtAsync(_aktoer);
    }

    private List<LokationOversigt> Synlige()
    {
        var soeg = _soeg.Trim();
        return (_lokationer ?? [])
            .Where(l => _statusFilter == "alle"
                || (_statusFilter == "aktiv") == (l.Status == LokationStatus.Aktiv))
            .Where(l => _orgFilter == "alle" || l.OrganisationId.ToString() == _orgFilter)
            .Where(l => soeg.Length == 0
                || l.Navn.Contains(soeg, StringComparison.CurrentCultureIgnoreCase)
                || (l.Adresse?.Contains(soeg, StringComparison.CurrentCultureIgnoreCase) ?? false))
            .ToList();
    }

    private string Antaltekst()
    {
        var n = Synlige().Count;
        var alle = _lokationer?.Count ?? 0;
        return n == alle ? $"{alle} lokationer" : $"{n} af {alle} lokationer";
    }

    private void NulstilFiltre()
    {
        _soeg = string.Empty;
        _statusFilter = "alle";
        _orgFilter = "alle";
    }

    private void VisOpret()
    {
        _viserForm = true;
        _formId = null;
        _formOrg = string.Empty;
        _formNavn = string.Empty;
        _formAdresse = string.Empty;
        _formTidszone = LokationService.Tidszoner[0];
        _formFejl = null;
        _besked = null;
    }

    private void VisRediger(LokationOversigt l)
    {
        _viserForm = true;
        _formId = l.Id;
        _formNavn = l.Navn;
        _formAdresse = l.Adresse ?? string.Empty;
        _formTidszone = l.Tidszone;
        _formFejl = null;
        _besked = null;
    }

    private void AnnullerForm()
    {
        _viserForm = false;
        _formFejl = null;
    }

    private async Task GemAsync()
    {
        if (_arbejder || _aktoer is null) return;

        Guid organisationId;
        if (_formId is null)
        {
            if (_aktoer.ErPlatformAdmin)
            {
                if (!Guid.TryParse(_formOrg, out organisationId))
                {
                    _formFejl = "Vælg en organisation.";
                    return;
                }
            }
            else if (_aktoer.OrganisationId is { } egen)
            {
                organisationId = egen;
            }
            else
            {
                _formFejl = Fejltekst(LokationFejl.IkkeTilladt);
                return;
            }
        }
        else
        {
            organisationId = Guid.Empty;
        }

        _arbejder = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var service = scope.ServiceProvider.GetRequiredService<LokationService>();

            var resultat = _formId is { } id
                ? await service.RedigerAsync(_aktoer, id, _formNavn, _formAdresse, _formTidszone)
                : await service.OpretAsync(_aktoer, organisationId, _formNavn, _formAdresse, _formTidszone);

            if (!resultat.Ok)
            {
                _formFejl = Fejltekst(resultat.Fejl);
                return;
            }

            _besked = _formId is null
                ? $"Lokationen {resultat.Lokation!.Navn} er oprettet."
                : $"Lokationen {resultat.Lokation!.Navn} er opdateret.";
            _viserForm = false;
            _formFejl = null;
            await HentAsync();
        }
        finally
        {
            _arbejder = false;
        }
    }

    private async Task SkiftStatusAsync(LokationOversigt l)
    {
        if (_arbejder || _aktoer is null) return;
        _arbejder = true;
        try
        {
            var ny = l.Status == LokationStatus.Aktiv ? LokationStatus.Deaktiveret : LokationStatus.Aktiv;
            await using var scope = ScopeFactory.CreateAsyncScope();
            var resultat = await scope.ServiceProvider.GetRequiredService<LokationService>().SaetStatusAsync(_aktoer, l.Id, ny);

            _besked = resultat.Ok
                ? $"{l.Navn} er {(ny == LokationStatus.Aktiv ? "aktiveret" : "deaktiveret")}."
                : Fejltekst(resultat.Fejl);
            await HentAsync();
        }
        finally
        {
            _arbejder = false;
        }
    }

    private static string Fejltekst(LokationFejl fejl) => fejl switch
    {
        LokationFejl.IkkeTilladt => "Du har ikke ret til at gøre det.",
        LokationFejl.NavnUgyldigt => $"Navnet skal være mellem 1 og {LokationService.MaxNavnLaengde} tegn.",
        LokationFejl.NavnFindesAllerede => "Der findes allerede en lokation med det navn i organisationen.",
        LokationFejl.TidszoneUgyldig => "Vælg en gyldig tidszone.",
        LokationFejl.AdresseUgyldig => $"Adressen må højst være {LokationService.MaxAdresseLaengde} tegn.",
        LokationFejl.OrganisationIkkeFundet => "Organisationen findes ikke længere.",
        LokationFejl.IkkeFundet => "Lokationen findes ikke længere.",
        _ => "Noget gik galt. Prøv igen."
    };
}
