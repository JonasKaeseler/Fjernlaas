@inherits LayoutComponentBase

<div class="shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">FL</div>
            <div>
                <div class="brand-name">Fjernlås</div>
                <div class="brand-sub">Administration</div>
            </div>
        </div>

        <nav class="nav">
            <NavLink href="" Match="NavLinkMatch.All" class="nav-link">Oversigt</NavLink>
            <AuthorizeView Policy="@Politikker.PlatformAdmin">
                <NavLink href="organisationer" class="nav-link">Organisationer</NavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@Politikker.Administration">
                <NavLink href="lokationer" class="nav-link">Lokationer</NavLink>
                <NavLink href="forbindelser" class="nav-link">TTLock</NavLink>
                <NavLink href="sms" class="nav-link">SMS og nøgleord</NavLink>
                <NavLink href="brugere" class="nav-link">Brugere</NavLink>
            </AuthorizeView>
        </nav>

        <div class="sidebar-foot">
            <AuthorizeView>
                <Authorized>
                    <div class="user">
                        <div class="user-name">@(context.User.FindFirst(AppClaims.Navn)?.Value ?? context.User.Identity?.Name)</div>
                        <div class="user-sub">@Rolletekst(context.User)</div>
                    </div>
                    <form method="post" action="/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-secondary btn-block">Log ud</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

@code {
    private static string Rolletekst(ClaimsPrincipal bruger) =>
        bruger.IsInRole(Roller.PlatformAdmin) ? "Platformsadministrator"
        : bruger.IsInRole(Roller.OrganisationAdmin) ? "Administrator"
        : "Bruger";
}
