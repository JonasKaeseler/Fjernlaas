# Kopiér til .env på serveren. Må aldrig committes.
DOMAIN=fjernlaas.example.dk
# Skal opfylde SQL Servers krav (mindst 8 tegn, store og små bogstaver, tal og tegn). Brug en lang tilfældig kode uden semikolon, lighedstegn og dollartegn (den indgår i en forbindelsesstreng).
SA_PASSWORD=
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
# Bruges kun første gang til at oprette platformsadmin. Fjern adgangskoden igen bagefter.
PLATFORMADMIN_EMAIL=
PLATFORMADMIN_PASSWORD=
# Billedet fra GitHub Container Registry. Sættes af deploy-flowet; standard er seneste.
APP_IMAGE=ghcr.io/jonaskaeseler/fjernlaas:latest
